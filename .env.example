# Solana mainnet RPC (public default is rate-limited — use Helius/QuickNode/etc for production)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Protocol wallet that permanently receives 100% (10000 bps) of Pump.fun creator fees.
# Locked for this product — copy into .env.local:
NEXT_PUBLIC_PROTOCOL_FEE_WALLET=D7rAgM8vJzYVgYDnzqein9uYkRp4aW7BGkT99QSPBExy
# Server-side upstream for /api/solana-rpc (browser never talks to this directly)
SOLANA_RPC_UPSTREAM=https://solana.publicnode.com
